# Copy this to .env and fill in your keys

# ── Required ───────────────────────────────────────────
# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Auto-Apply (browser automation) ───────────────────
# LinkedIn credentials (for Easy Apply)
LINKEDIN_EMAIL=sonidhwaniwork@gmail.com
LINKEDIN_PASSWORD=your-linkedin-password

# Indeed credentials (uses LinkedIn creds by default if not set)
INDEED_EMAIL=sonidhwaniwork@gmail.com
INDEED_PASSWORD=your-indeed-password

# ── Optional: Gmail + Google Sheets sync ──────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project, enable Gmail API + Google Sheets API + Google Drive API
# 3. Create OAuth 2.0 credentials (Desktop App)
# 4. Download as credentials.json and place it in this directory
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
